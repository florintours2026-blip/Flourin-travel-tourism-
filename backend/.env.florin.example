# =========================
# FLORIN API
# =========================

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Firebase Admin
# Option A:
FIREBASE_SERVICE_ACCOUNT_FILE=/absolute/path/to/firebase-service-account.json
# Option B: put the complete JSON on one line:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Frontend origins
FLORIN_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://YOUR-DOMAIN.com

# =========================
# Booking.com Demand API
# =========================
BOOKING_BASE_URL=https://demandapi.booking.com/3.2
BOOKING_API_KEY=
BOOKING_AFFILIATE_ID=

# =========================
# Agoda Demand API
# =========================
# The exact endpoint/model is provided for your approved Agoda partnership.
AGODA_BASE_URL=
AGODA_SITE_ID=
AGODA_API_KEY=

# =========================
# Trip.com partner API
# =========================
# Configure the endpoint/credentials supplied by Trip.com.
TRIP_BASE_URL=
TRIP_API_KEY=

# =========================
# Pricing
# =========================
CUSTOMER_MARKUP=20
AGENT_MARKUP=10
FRIDAY_DISCOUNT=5

# =========================
# Direct airline / NDC
# =========================
# JSON example:
# AIRLINE_API_CONFIG={"egyptair":{"base_url":"https://YOUR-NDC-ENDPOINT","type":"ndc","api_key":"..."}}
AIRLINE_API_CONFIG={}
