rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // FLORIN bootstrap administrator UID supplied for this project.
    // This is not a secret; Firebase Auth still requires a valid signed-in user token.
    function bootstrapAdmin() {
      return request.auth != null && request.auth.uid == "7nE6QoTEPFOk0IhwcZUnymkyzoY2";
    }
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return bootstrapAdmin()
        || (signedIn()
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
          && (get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true
              || get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == "true"));
    }

    match /admins/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow create, update: if signedIn() && request.auth.uid == userId;
      allow read: if (signedIn() && request.auth.uid == userId) || isAdmin();
      allow delete: if isAdmin();
    }

    match /offers/{offerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /tourPackages/{packageId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /airlines/{airlineId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /bookings/{bookingId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /activityLogs/{logId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /siteContent/{contentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
